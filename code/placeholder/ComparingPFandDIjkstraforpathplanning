clear; clc; close all;

%% === 1. Load Data =========================================================
riskMap = readmatrix('riskMap.csv');   % fatality risk per accident (per cell)
lat     = readmatrix('lat.csv');       % latitude grid
lon     = readmatrix('lon.csv');       % longitude grid

[nRows, nCols] = size(riskMap);

%% === 1a. Grid resolution & UAV cell time ==================================
R = 6371000;  % Earth radius (m)

% Horizontal distance (1,1) to (1,2)
dlat = deg2rad(lat(1,2) - lat(1,1));
dlon = deg2rad(lon(1,2) - lon(1,1));
latm = deg2rad((lat(1,1) + lat(1,2))/2);
dx = R * sqrt( dlat^2 + (cos(latm)*dlon)^2 );

% Vertical distance (1,1) to (2,1)
dlat = deg2rad(lat(2,1) - lat(1,1));
dlon = deg2rad(lon(2,1) - lon(1,1));
latm = deg2rad((lat(1,1) + lat(1,2))/2);
dy = R * sqrt( dlat^2 + (cos(latm)*dlon)^2 );

cellSize = mean([dx dy]);
v_uav = 12;                     % UAV speed (m/s)
dt_cell = cellSize / v_uav;     % overflight time per cell (s)

%% === 1b. Convert fatality risk → induced risk ==============================
failureRate_per_hour = 8e-5;                 % UAV failure rate (per hour)
lambda = failureRate_per_hour / 3600;        % per second
induced_risk = lambda * dt_cell .* riskMap;  % per-cell induced fatality prob

%% === 2. User Inputs START and GOAL ========================================
figure;
imagesc(induced_risk);
set(gca,'YDir','normal');
axis equal tight;
colormap(jet); colorbar;
title('Induced Fatality Risk Map');
xlabel('Column j'); ylabel('Row i');
hold on; drawnow;

fprintf('\n=== ENTER START point (grid indices) ===\n');
start_i = input('  Row index i (1..nRows): ');
start_j = input('  Col index j (1..nCols): ');

fprintf('\n=== ENTER GOAL point (grid indices) ===\n');
goal_i = input('  Row index i (1..nRows): ');
goal_j = input('  Col index j (1..nCols): ');

% Validate indices
start_i = round(max(1, min(nRows, start_i)));
start_j = round(max(1, min(nCols, start_j)));
goal_i  = round(max(1, min(nRows, goal_i)));
goal_j  = round(max(1, min(nCols, goal_j)));

fprintf('START = (%d,%d), GOAL = (%d,%d)\n', start_i,start_j, goal_i,goal_j);

% Plot markers
plot(start_j,start_i,'go','MarkerSize',12,'LineWidth',2);
plot(goal_j,goal_i,'rx','MarkerSize',12,'LineWidth',2);

%% === 3. Mission TLS =======================================================
TLS_thr = 1e-8;   % per flight
fprintf('Using mission-level TLS = %.1e\n', TLS_thr);

%% === 4. Run Potential Field Algorithm ====================================
[path_pf, time_pf, metrics_pf] = runPotentialField( ...
    induced_risk, start_i, start_j, goal_i, goal_j, TLS_thr);

%% === 4b. Run A* Algorithm (TLS-constrained) ===============================
% Risk weight trades off length vs risk. If A* goes too straight: increase it.
% If A* struggles to find a path: decrease it.
w_risk_astar = 5e8;

[path_astar, time_astar, metrics_astar] = runAstarTLS( ...
    induced_risk, start_i, start_j, goal_i, goal_j, TLS_thr, w_risk_astar);

%% === 5. OUTPUT ONE PLOT: Induced Risk Map + BOTH Paths ====================
figure;
imagesc(induced_risk);
set(gca,'YDir','normal');
axis equal tight;
colormap(jet); colorbar;
hold on;

if ~isempty(path_pf)
    plot(path_pf(:,2), path_pf(:,1), 'w-', 'LineWidth',2);
end
if ~isempty(path_astar)
    plot(path_astar(:,2), path_astar(:,1), '-', 'LineWidth',2); % default color
end

plot(start_j,start_i,'go','MarkerSize',12,'LineWidth',2);
plot(goal_j,goal_i,'rx','MarkerSize',12,'LineWidth',2);

title('PF vs. A* on Induced Fatality Risk Map');
xlabel('Column j'); ylabel('Row i');
legend({'PF Path','A* Path','Start','Goal'},'Location','northwest');

%% === Metrics printed ======================================================
fprintf('\n===== Potential Field Results =====\n');
fprintf('Runtime (s):                %.4f\n', time_pf);
fprintf('Path length (cells):        %.2f\n', metrics_pf.length);
fprintf('Max induced risk/cell:      %.3g\n', metrics_pf.maxRisk);
fprintf('Mean induced risk/cell:     %.3g\n', metrics_pf.meanRisk);
fprintf('Total fatality probability: %.3g\n', metrics_pf.totalFatalityRisk);
fprintf('TLS Feasible?               %s\n', yesno(metrics_pf.TLS_feasible));

fprintf('\n===== A* Results (TLS-constrained) =====\n');
fprintf('Runtime (s):                %.4f\n', time_astar);
fprintf('Path length (cells):        %.2f\n', metrics_astar.length);
fprintf('Max induced risk/cell:      %.3g\n', metrics_astar.maxRisk);
fprintf('Mean induced risk/cell:     %.3g\n', metrics_astar.meanRisk);
fprintf('Total fatality probability: %.3g\n', metrics_astar.totalFatalityRisk);
fprintf('TLS Feasible?               %s\n', yesno(metrics_astar.TLS_feasible));
fprintf('A* risk weight w_risk:      %.3g\n', w_risk_astar);

%% ======================= HELPER FUNCTIONS ================================

function out = yesno(x)
    if x, out = 'Yes'; else, out = 'No'; end
end

% ------------------------- Potential Field (yours) -------------------------
function [path, time_pf, metrics] = runPotentialField( ...
            induced_risk, start_i, start_j, goal_i, goal_j, TLS_thr)

    [nRows,nCols] = size(induced_risk);
    [jGrid,iGrid] = meshgrid(1:nCols, 1:nRows);

    %% Cost field = distance + risk avoidance
    w_dist = 1;
    w_risk = 50;

    U_att = sqrt( (iGrid - goal_i).^2 + (jGrid - goal_j).^2 );
    U_rep = w_risk ./ (induced_risk + 1e-20);
    U_rep(U_rep > 1e6) = 1e6;

    U = w_dist * U_att + U_rep;
    U = (U - min(U(:))) / (max(U(:)) - min(U(:)) + eps);

    %% Gradient descent search
    path_i = start_i;  path_j = start_j;
    prev_i = start_i;  prev_j = start_j;

    path = [path_i, path_j];
    maxSteps = 8000;
    tol = 2;
    escape_counter = 0;

    tic;
    for step = 1:maxSteps

        % Close to goal?
        distGoal = hypot(path_i - goal_i, path_j - goal_j);
        if distGoal < 30
            di = sign(goal_i - path_i);
            dj = sign(goal_j - path_j);
            path_i = max(1, min(nRows, path_i + di));
            path_j = max(1, min(nCols, path_j + dj));

            path = [path; path_i, path_j];
            if distGoal < tol, break; end
            continue;
        end

        % Choose lowest-cost neighbor
        bestU = inf;
        next_i = path_i;  next_j = path_j;

        for di = -1:1
            for dj = -1:1
                if di==0 && dj==0, continue; end
                ni = path_i + di; nj = path_j + dj;
                if ni>=1 && ni<=nRows && nj>=1 && nj<=nCols
                    if U(ni,nj) < bestU
                        bestU = U(ni,nj);
                        next_i = ni; next_j = nj;
                    end
                end
            end
        end

        % Escape if stuck
        if next_i == path_i && next_j == path_j
            escape_counter = escape_counter + 1;
            if escape_counter > 8
                ri = randi([-1 1]); rj = randi([-1 1]);
                ni = path_i + ri; nj = path_j + rj;
                if ni>=1 && ni<=nRows && nj>=1 && nj<=nCols
                    next_i = ni; next_j = nj;
                end
                escape_counter = 0;
            end
        end

        % Momentum
        path_i = round(max(1, min(nRows, next_i + 0.2*(next_i - prev_i))));
        path_j = round(max(1, min(nCols, next_j + 0.2*(next_j - prev_j))));
        prev_i = next_i; prev_j = next_j;

        path = [path; path_i, path_j];
    end
    time_pf = toc;

    metrics = evaluate_path(path, induced_risk, TLS_thr);
end

% ---------------------------- A* (added) ----------------------------------
function [path, time_astar, metrics] = runAstarTLS( ...
        induced_risk, start_i, start_j, goal_i, goal_j, TLS_thr, w_risk)

    [nRows,nCols] = size(induced_risk);

    % Precompute log(1 - risk) for stable TLS accumulation
    log1m = log(max(1 - induced_risk, realmin)); % avoid log(0)

    startIdx = sub2ind([nRows nCols], start_i, start_j);
    goalIdx  = sub2ind([nRows nCols], goal_i, goal_j);

    N = nRows*nCols;

    % A* arrays
    gLen     = inf(N,1);
    gRiskSum = inf(N,1);
    logSurv  = -inf(N,1);               % log(survival)
    parent   = zeros(N,1,'uint32');
    closed   = false(N,1);
    inOpen   = false(N,1);
    fScore   = inf(N,1);

    % Init at start (include start cell risk)
    gLen(startIdx)     = 0;
    gRiskSum(startIdx) = induced_risk(start_i,start_j);
    logSurv(startIdx)  = log1m(start_i,start_j);
    parent(startIdx)   = uint32(startIdx);   % IMPORTANT: prevents broken chain

    % Heuristic (Euclidean distance in grid cells)
    h0 = hypot(start_i - goal_i, start_j - goal_j);

    % f = length + weighted risk + heuristic
    fScore(startIdx) = gLen(startIdx) + w_risk*gRiskSum(startIdx) + h0;

    openList = uint32(startIdx);
    inOpen(startIdx) = true;

    maxIters = N*5;

    tic;
    it = 0;
    found = false;

    while ~isempty(openList) && it < maxIters
        it = it + 1;

        % Pop node with minimum fScore (simple priority queue using array)
        [~,k] = min(fScore(double(openList)));
        current = openList(k);
        openList(k) = [];
        inOpen(double(current)) = false;

        if current == uint32(goalIdx)
            found = true;
            break;
        end

        closed(double(current)) = true;
        [ci,cj] = ind2sub([nRows nCols], double(current));

        for di = -1:1
            for dj = -1:1
                if di==0 && dj==0, continue; end
                ni = ci + di; nj = cj + dj;
                if ni < 1 || ni > nRows || nj < 1 || nj > nCols
                    continue;
                end

                neighbor = uint32(sub2ind([nRows nCols], ni, nj));
                if closed(double(neighbor)), continue; end

                stepLen = hypot(di,dj);

                tentative_gLen = gLen(double(current)) + stepLen;
                tentative_gRiskSum = gRiskSum(double(current)) + induced_risk(ni,nj);
                tentative_logSurv = logSurv(double(current)) + log1m(ni,nj);

                % Hard TLS constraint on partial path
                tentative_fatality = 1 - exp(tentative_logSurv);
                if tentative_fatality > TLS_thr
                    continue;
                end

                newCost = tentative_gLen + w_risk*tentative_gRiskSum;
                oldCost = gLen(double(neighbor)) + w_risk*gRiskSum(double(neighbor));

                if newCost < oldCost
                    parent(double(neighbor)) = current;
                    gLen(double(neighbor)) = tentative_gLen;
                    gRiskSum(double(neighbor)) = tentative_gRiskSum;
                    logSurv(double(neighbor)) = tentative_logSurv;

                    h = hypot(ni - goal_i, nj - goal_j);
                    fScore(double(neighbor)) = newCost + h;

                    if ~inOpen(double(neighbor))
                        openList(end+1) = neighbor; %#ok<AGROW>
                        inOpen(double(neighbor)) = true;
                    end
                end
            end
        end
    end

    time_astar = toc;

    if ~found
        warning('A* did not find a TLS-feasible path (or hit iteration limit). Returning empty path.');
        path = [];
        metrics = struct('length',inf,'maxRisk',inf,'meanRisk',inf,'totalFatalityRisk',inf,'TLS_feasible',false);
        return;
    end

    % --- SAFE path reconstruction (preallocated + cycle detection) ----------
    maxBacktrack = N;
    pathIdx = zeros(maxBacktrack,1,'uint32');
    visited = false(N,1);

    cur = uint32(goalIdx);
    k = 1;

    while cur ~= uint32(startIdx)
        if cur == 0 || k >= maxBacktrack
            warning('Path reconstruction failed (broken chain or too long). Returning empty path.');
            path = [];
            metrics = struct('length',inf,'maxRisk',inf,'meanRisk',inf,'totalFatalityRisk',inf,'TLS_feasible',false);
            return;
        end

        if visited(double(cur))
            warning('Path reconstruction detected a cycle in parent pointers. Returning empty path.');
            path = [];
            metrics = struct('length',inf,'maxRisk',inf,'meanRisk',inf,'totalFatalityRisk',inf,'TLS_feasible',false);
            return;
        end
        visited(double(cur)) = true;

        pathIdx(k) = cur;
        cur = parent(double(cur));
        k = k + 1;
    end

    pathIdx(k) = uint32(startIdx);
    pathIdx = flipud(pathIdx(1:k));
    % -----------------------------------------------------------------------

    [pi,pj] = ind2sub([nRows nCols], double(pathIdx));
    path = [pi(:) pj(:)];

    metrics = evaluate_path(path, induced_risk, TLS_thr);
end

% --------------------------- Metrics (shared) ------------------------------
function metrics = evaluate_path(path, induced_risk, TLS_thr)
    if isempty(path)
        metrics.length = inf;
        metrics.maxRisk = inf;
        metrics.meanRisk = inf;
        metrics.totalFatalityRisk = inf;
        metrics.TLS_feasible = false;
        return;
    end

    pi = path(:,1); pj = path(:,2);

    segLen = hypot(diff(pi), diff(pj));
    metrics.length = sum(segLen);

    risk_vals = induced_risk(sub2ind(size(induced_risk), pi, pj));

    metrics.maxRisk = max(risk_vals);
    metrics.meanRisk = mean(risk_vals);
    metrics.totalFatalityRisk = 1 - prod(1 - risk_vals);

    metrics.TLS_feasible = (metrics.totalFatalityRisk <= TLS_thr);
end
